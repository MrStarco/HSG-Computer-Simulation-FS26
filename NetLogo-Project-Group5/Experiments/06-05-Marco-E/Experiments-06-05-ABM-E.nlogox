  <experiments>
    <experiment name="exp1_policy_grid" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="300">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>committed-misconduct-total</metric>
        <metric>punished-misconduct-total</metric>
        <metric>hidden-misconduct-total</metric>
        <metric>hidden-misconduct-rate</metric>
        <metric>reported-events-total</metric>
        <metric>retaliation-events-total</metric>
        <metric>mean [fear] of employees</metric>
        <metric>mean [misconduct-propensity] of employees</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-employees">
          <value value="300"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-misconduct-propensity">
          <value value="0.4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-fear">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="learning-rate">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="baseline-recovery-rate">
          <value value="0.05"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="punishment-severity" first="0.2" step="0.05" last="0.8"></steppedValueSet>
        <steppedValueSet variable="reporter-protection" first="0.2" step="0.05" last="0.8"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="exp2a_sens_employees" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="300">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>committed-misconduct-total</metric>
        <metric>punished-misconduct-total</metric>
        <metric>hidden-misconduct-total</metric>
        <metric>hidden-misconduct-rate</metric>
        <metric>reported-events-total</metric>
        <metric>retaliation-events-total</metric>
        <metric>mean [fear] of employees</metric>
        <metric>mean [misconduct-propensity] of employees</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="number-employees">
          <value value="50"></value>
          <value value="100"></value>
          <value value="150"></value>
          <value value="200"></value>
          <value value="250"></value>
          <value value="300"></value>
          <value value="400"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-misconduct-propensity">
          <value value="0.4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="initial-fear">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="punishment-severity">
          <value value="0.5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="reporter-protection">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="learning-rate">
          <value value="0.2"></value>
